# Set this separately in Development, Preview, and Production.
# Development example: http://localhost:3000
# Preview/Production: the exact HTTPS origin, without a trailing slash.
APP_URL=http://localhost:3000

# Public Supabase config (the anon/publishable key is intentionally browser-visible)
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# SERVER ONLY - never expose these in NEXT_PUBLIC_ variables
# SUPABASE_URL is optional when it matches NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
AUTH_SECRET=generate-a-long-random-value

# Direct Google OAuth
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# Direct Discord OAuth
DISCORD_CLIENT_ID=xxx
DISCORD_CLIENT_SECRET=xxx

# Optional live card payments (Stripe Checkout)
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STORE_CURRENCY=usd

# Reserved for a future tested distributor adapter. The current workflow is manual.
# DISTRIBUTOR_API_URL=
# DISTRIBUTOR_API_KEY=
