# Public Supabase config
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# SERVER ONLY - never expose these in NEXT_PUBLIC_ variables
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
AUTH_SECRET=generate-a-long-random-value
OWNER_EMAIL=your-google-email@example.com

# Direct Google OAuth
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# Direct Discord OAuth
DISCORD_CLIENT_ID=xxx
DISCORD_CLIENT_SECRET=xxx

# Optional live card payments (Stripe Checkout)
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STORE_CURRENCY=usd
